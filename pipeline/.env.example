# No credentials or API keys are required by this pipeline - all inputs and
# outputs are local CSV/JSON files. This file exists only for the optional
# Docker/Airflow environment knobs below; copy it to `.env` if you want to
# override defaults.

# Airflow's own home directory for its metadata DB/logs when running outside
# Docker (defaults to pipeline/.airflow-home if unset - see docs/QUICKSTART.md).
AIRFLOW_HOME=./.airflow-home
